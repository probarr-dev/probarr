# Copy to .env and fill in. .env is gitignored and must NEVER be committed.

# Optional: Dispatcharr exporter/source
CHANNELIQ_DISPATCHARR_URL=http://dispatcharr:9191
CHANNELIQ_DISPATCHARR_USER=
